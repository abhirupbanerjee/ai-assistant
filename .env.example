# AI Assistant - Environment Configuration
# Copy this file to .env.local for development or .env for production
#
# IMPORTANT: Docker Compose (and the root Makefile: make up/down/build) reads
# ONLY .env — .env.local is used by `npm run dev` / Next.js, never by compose.
# For any `make up` deployment, copy this file to .env and fill in the values.
#
# Legend:
#   [REQUIRED] - Must be set for the application to work
#   [OPTIONAL] - Enhanced features, can be omitted
#   [PRODUCTION] - Required only for production deployment
#   [HAS DEFAULT] - Has a sensible default, override if needed

# ============================================================================
#                           REQUIRED - Core Configuration
# ============================================================================

# [REQUIRED - at least one LLM provider] OpenAI API Key — direct API calls (no proxy)
# You may substitute any other provider from the "Additional LLM Providers"
# section instead (Anthropic, Gemini, Mistral, DeepSeek, Moonshot, Ollama).
OPENAI_API_KEY=sk-your-api-key-here

# [OPTIONAL] OpenAI Admin API Key — required for spend tracking in Pricing tab
# Standard API keys (sk-...) cannot access the /v1/organization/costs endpoint.
# Get from: https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_API_KEY=

# [REQUIRED] Admin email addresses (comma-separated)
# These users will have full admin access to the dashboard
ADMIN_EMAILS=admin@example.com

# [REQUIRED for Production] NextAuth secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-secure-random-string

# ============================================================================
#                         REQUIRED - Infrastructure Services
# ============================================================================
#
# DOCKER COMPOSE PROFILES:
# Use profiles to start only the services you need:
#   PostgreSQL + Qdrant:   docker compose --profile postgres --profile qdrant up -d
# Or set COMPOSE_PROFILES in .env — required for the Makefile shortcuts
# (make up / make build pass no --profile flags; they read COMPOSE_PROFILES):
#   COMPOSE_PROFILES=postgres,qdrant
#
# Connector profiles (optional — only needed if connector is configured):
#   github — GitHub Connector (repos, issues, PRs)
#   notion — Notion Connector (pages, databases, search)
#   slack  — Slack Connector (messages, channels, users)
#   gitbook — GitBook Connector (spaces, pages, search, comments)
#
# All services example:
#   COMPOSE_PROFILES=postgres,qdrant,github,notion,slack,gitbook

# [OPTIONAL] Qdrant Connection
# Development: localhost | Production: qdrant (Docker service name)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ============================================================================
#                         Database Provider Selection
# ============================================================================

# [HAS DEFAULT] Database Provider Selection
# Options: sqlite | postgres
# Default: sqlite (use --profile postgres for PostgreSQL)
DATABASE_PROVIDER=sqlite

# [REQUIRED when DATABASE_PROVIDER=sqlite] SQLite database path
# Development: ./data/policybot.db | Production: /app/data/policybot.db
SQLITE_DB_PATH=./data/policybot.db

# [REQUIRED when DATABASE_PROVIDER=postgres] PostgreSQL connection settings
# In Docker, DATABASE_URL is auto-composed from these three values (see
# docker-compose.yml) — the DATABASE_URL line below is IGNORED in Docker and
# only used for local `npm run dev`. Keep the password in sync in both places
# if you set DATABASE_URL manually for local development.
POSTGRES_USER=policybot
POSTGRES_PASSWORD=
POSTGRES_DB=policybot
# Local dev only (ignored by Docker — auto-composed from POSTGRES_* above)
DATABASE_URL=postgresql://policybot:password@localhost:5432/policybot

# [HAS DEFAULT] PostgreSQL Connection Pool Settings (only used with DATABASE_PROVIDER=postgres)
# Adjust based on concurrent users. See docs/tech/DB-techstack.md for sizing guide.
# Default: 20 (suitable for ~100 concurrent users with typical query patterns)
DATABASE_POOL_MAX=20
# Idle timeout in ms - connections idle longer than this are closed (default: 30000)
DATABASE_POOL_IDLE_TIMEOUT=30000
# Connection timeout in ms - max time to wait for a connection (default: 10000)
DATABASE_POOL_CONNECTION_TIMEOUT=10000

# [REQUIRED] Redis Connection
# Development: redis://localhost:6379 | Production: redis://redis:6379
REDIS_URL=redis://localhost:6379

# [REQUIRED] Data storage directory
# Development: ./data | Production: /app/data
DATA_DIR=./data

# [HAS DEFAULT] Maximum upload size for file uploads (backup restore, documents)
# Accepts values like: 100mb, 500mb, 1gb, 2gb
# Default: 500mb (requires rebuild to take effect)
# Increase if you have large backup files to restore
MAX_UPLOAD_SIZE=500mb

# ============================================================================
#                      REQUIRED for Production - Authentication
# ============================================================================

# [PRODUCTION] Base URL of your application
# When deploying behind a reverse proxy (like Traefik), NextAuth automatically trusts
# X-Forwarded-* headers when trustHost: true is set in auth-options.ts
# Ensure NEXTAUTH_URL matches your external HTTPS domain (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# [PRODUCTION] At least one OAuth provider must be configured:

# Azure AD Configuration (get from Azure Portal > App registrations)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Google OAuth Configuration (get from Google Cloud Console > Credentials)
# Used for both login (NextAuth) and the Drive Connector "Connect your Drive"
# flow. Register this redirect URI in Google Cloud Console > Credentials:
#   {NEXTAUTH_URL}/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [HAS DEFAULT] Access control mode
# - 'allowlist': Only users in the database can sign in (default)
# - 'domain': Any user from ALLOWED_DOMAINS can sign in
ACCESS_MODE=allowlist

# [OPTIONAL] Comma-separated list of allowed email domains
# Only used when ACCESS_MODE=domain
ALLOWED_DOMAINS=example.com,company.org

# [DEVELOPMENT ONLY] Set to 'true' to disable auth entirely.
# DANGER: with NODE_ENV=production the process exits immediately when this is
# 'true' (see src/lib/auth.ts) — a production container will crash-loop.
# Keep it commented out unless you know you need it.
#AUTH_DISABLED=true

# [HAS DEFAULT] Global kill switch for MCP (Model Context Protocol) tool integration.
# When 'false', all MCP functionality is disabled: no server discovery, no MCP tools
# in LLM context, and execution returns a structured disabled error. Requires restart.
# Default: true (MCP enabled)
MCP_ENABLED=true

# [OPTIONAL] Credentials Authentication
# Enable email/password login (default: enabled)
# Useful for: fresh VM setup, development mode, offline/Ollama scenarios
# Set password for the first admin in ADMIN_EMAILS list
# Only used on first run if admin has no password set
CREDENTIALS_ADMIN_PASSWORD=

# ============================================================================
#                      REQUIRED for Production - Deployment
# ============================================================================

# [OPTIONAL] Allowed origins for iframe embedding on /e/* embed routes
# Comma-separated list of origins that may embed the chatbot widget
# Example: https://portal.example.com,https://other.example.com
ALLOWED_EMBED_ORIGINS=

# [PRODUCTION] Your domain name for Traefik routing
DOMAIN=ai.abhirup.app

# [PRODUCTION] Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# ============================================================================
#                      OPTIONAL - Additional LLM Providers
# ============================================================================
# All providers use direct native SDKs/APIs — no proxy required.
# Route 2 (Direct Providers): OpenAI, Anthropic, Gemini, Mistral, DeepSeek, Moonshot
# Route 3 (Local): Ollama
# Route 5 (Aggregator Gateways): Azure AI Foundry, Fireworks AI, Ollama Cloud

# [OPTIONAL] Mistral API - Used for chat completions, embeddings, STT, and PDF OCR
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# [OPTIONAL] Google Gemini - Advanced reasoning models with 1M context
# Get from: https://ai.google.dev/
GEMINI_API_KEY=

# [OPTIONAL] Ollama - Local models (no API cost)
# Use http://host.docker.internal:11434 when running in Docker
OLLAMA_API_BASE=http://localhost:11434

# [OPTIONAL] Anthropic Claude - Advanced reasoning and coding models
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# [OPTIONAL] Anthropic Admin API Key — required for spend tracking in Pricing tab
# Standard API keys cannot access the /v1/organizations/cost_report endpoint.
# Get from: https://console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_API_KEY=

# [OPTIONAL] DeepSeek - Cost-effective reasoning models
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# [OPTIONAL] Fireworks AI - SOC2/GDPR/HIPAA compliant, Zero Data Retention
# Hosts: MiniMax M2.5, Kimi K2.5, GPT-OSS 20B/120B, Qwen3 8B
# Get from: https://fireworks.ai/account/api-keys
FIREWORKS_AI_API_KEY=

# [OPTIONAL] Moonshot AI API key
# Used for Route 2 direct access to Moonshot / Kimi models
# Get from: https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# [OPTIONAL] Moonshot AI API base
# Override only if using a custom Moonshot-compatible endpoint
MOONSHOT_API_BASE=

# [OPTIONAL] Ollama Cloud - Cloud-hosted models via https://ollama.com/api
# Route 5: Aggregator gateway alongside Fireworks AI and Azure AI Foundry.
# Uses native Ollama API format with Bearer token authentication.
# Get from: https://ollama.com/settings/keys
OLLAMA_CLOUD_API_KEY=

# [OPTIONAL] Azure AI Foundry (Serverless) — Aggregator Gateway
# Route 5: Uses Microsoft Foundry SDK for serverless catalog model access.
# Auth via Entra ID (DefaultAzureCredential). Requires App Registration
# with Foundry User role on the Foundry resource.
# Endpoint format: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_ENDPOINT=

# Entra ID credentials (required for Foundry SDK):
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# [HAS DEFAULT] Embedding model name
# Direct provider dispatch (OpenAI, Mistral, Gemini, Fireworks, or Local)
# Default: text-embedding-3-large (3072 dimensions)
EMBEDDING_MODEL=text-embedding-3-large

# ============================================================================
#                      OPTIONAL - Document Processing
# ============================================================================

# [OPTIONAL] Azure Document Intelligence - Enhanced Office document support
# Supports: PDF, DOCX, XLSX, PPTX, Images with better quality than basic extraction
# Get from Azure Portal > Cognitive Services > Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ============================================================================
#                      OPTIONAL - RAG Enhancements
# ============================================================================

# [OPTIONAL] Cohere API - Chunk reranking for improved search relevance
# Improves RAG quality by re-scoring retrieved chunks
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# [OPTIONAL] Tavily API - Web search and URL extraction
# Enables real-time web search and web page content extraction
# Get from: https://tavily.com
TAVILY_API_KEY=

# [OPTIONAL] Website Analysis (Google PageSpeed Insights)
# Enables website performance, accessibility, SEO, and best practices analysis
# Works without API key but recommended for higher rate limits
# Get from: https://console.cloud.google.com/apis/credentials
# Note: Falls back to GOOGLE_API_KEY if PAGESPEED_API_KEY is not set
PAGESPEED_API_KEY=

# [OPTIONAL] Code Analysis (SonarCloud)
# Enables code quality analysis: bugs, vulnerabilities, code smells, coverage
# Required for code_analysis tool to function
# Get from: https://sonarcloud.io/account/security
SONARCLOUD_TOKEN=
SONARCLOUD_ORGANIZATION=

# [OPTIONAL] Load Testing (k6 Cloud)
# Enables distributed load testing for website performance validation
# Free tier: 50 VUh/month (~12 tests at 50 users for 5 min)
# Get from: https://app.k6.io/account/api-token
# NOTE: Can also be configured via Admin UI > Tools > Load Testing
K6_CLOUD_API_TOKEN=

# [OPTIONAL] YouTube transcript extraction
# NOTE: YouTube API key is now configured via Admin > Tools > YouTube
# Get API key from: https://supadata.ai (free $5 credit = ~5000 transcripts)
# The youtube-transcript npm fallback is available but may be blocked by YouTube

# ============================================================================
#                      OPTIONAL - Data Source Encryption
# ============================================================================

# [RECOMMENDED] Encryption key for API credentials stored in database
# Generate with: openssl rand -hex 32
# Required for secure storage of API keys and tokens for external data sources
DATA_SOURCE_ENCRYPTION_KEY=

# ============================================================================
#                      OPTIONAL - Drive Connector Microservice
# ============================================================================

# [REQUIRED when using `make up` / drive-connector] Bearer token shared between
# the app and drive-connector. The app reads it for the /api/drive/* bridge
# routes and the connector requires it for auth (min 16 chars). `make up`
# always includes the connector, so an empty value breaks Drive tools.
# Generate with: openssl rand -hex 32
CONNECTOR_BEARER_TOKEN=

# [OPTIONAL] Base URL of the drive-connector microservice.
# The app calls this from server-side bridge routes (/api/drive/*).
# Default: http://drive-connector:8090
DRIVE_CONNECTOR_URL=http://drive-connector:8090

# [OPTIONAL] SSRF hostname allowlist for admin-configured HTTP fetch targets.
# The SSRF guard blocks private/reserved IP ranges. Comma-separated hostnames
# listed here bypass that check so the app can reach trusted internal services
# (e.g. Docker-network microservices). Exact match only; wildcards are NOT
# supported. LLM-controlled tools (web_extract, pagespeed) stay fully guarded
# and do NOT use this allowlist. Set to 'drive-connector' to enable the
# connector at http://drive-connector:8090, and 'github-connector' for the
# GitHub connector at http://github-connector:8091. This is also required for
# the /api/drive/upload and /api/drive/folders server-side bridge routes.
SSRF_ALLOW_HOSTS=drive-connector,github-connector,notion-connector,slack-connector,gitbook-connector

# [OPTIONAL] HMAC secret for signing the X-Connector-User-Id header sent to
# the drive-connector microservice. Enables per-user OAuth (Connect your Drive).
# The connector verifies this signature so the LLM cannot spoof another user's
# identity via tool arguments. Generate with: openssl rand -hex 32
# Must match CONNECTOR_HMAC_SECRET in services/drive-connector/.env
CONNECTOR_HMAC_SECRET=

# [OPTIONAL] Base URL of this app, used by the drive-connector to call back
# and fetch per-user OAuth tokens from the vault endpoint
# (/api/connectors/vault/tokens). Required for Phase 2 per-user mode.
# The connector reads this as APP_BASE_URL in its own env.
# Example: https://assistant.example.com (no trailing slash)
APP_BASE_URL=

# [OPTIONAL] Microsoft Graph (OneDrive) connector configuration.
# The connector uses these for the app-only (client-credentials) fallback when
# a user has not connected their personal OneDrive. They default to the same
# Azure AD app registration used for login (AZURE_AD_*), or you can set a
# separate app registration with Files.ReadWrite application permissions.
# Register this redirect URI in Azure Portal > App registrations > Authentication:
#   {NEXTAUTH_URL}/api/connectors/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_GRAPH_TIMEOUT_MS=30000

# ============================================================================
#                      OPTIONAL - GitHub Connector
# ============================================================================

# [OPTIONAL] GitHub OAuth App credentials for the GitHub Connector
# Register an OAuth App at: https://github.com/settings/developers
# Homepage URL: {NEXTAUTH_URL}
# Authorization callback URL: {NEXTAUTH_URL}/api/connectors/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# [OPTIONAL] Bearer token for the GitHub connector microservice
# Generate with: openssl rand -hex 32
GITHUB_CONNECTOR_BEARER_TOKEN=

# [OPTIONAL] Base URL of the GitHub connector microservice.
# Default: http://github-connector:8091
GITHUB_CONNECTOR_URL=http://github-connector:8091

# ============================================================================
#                      OPTIONAL - Notion Connector
# ============================================================================

# [OPTIONAL] Notion OAuth integration credentials for the Notion Connector
# Create an integration at: https://www.notion.so/my-integrations
# Set the redirect URI to: {NEXTAUTH_URL}/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# [OPTIONAL] Bearer token for the Notion connector microservice
# Generate with: openssl rand -hex 32
NOTION_CONNECTOR_BEARER_TOKEN=

# [OPTIONAL] Base URL of the Notion connector microservice.
# Default: http://notion-connector:8092
NOTION_CONNECTOR_URL=http://notion-connector:8092

# ============================================================================
#                      OPTIONAL - Slack Connector
# ============================================================================

# [OPTIONAL] Slack OAuth App credentials for the Slack Connector
# Create an app at: https://api.slack.com/apps
# Set the redirect URI to: {NEXTAUTH_URL}/api/connectors/slack/callback
# OAuth scopes needed: channels:read, channels:history, search:read, users:read, team:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# [OPTIONAL] Bearer token for the Slack connector microservice
# Generate with: openssl rand -hex 32
SLACK_CONNECTOR_BEARER_TOKEN=

# [OPTIONAL] Base URL of the Slack connector microservice.
# Default: http://slack-connector:8093
SLACK_CONNECTOR_URL=http://slack-connector:8093

# ============================================================================
#                      OPTIONAL - GitBook Connector
# ============================================================================

# [OPTIONAL] GitBook OAuth App credentials for the GitBook Connector
# Register an OAuth App at: https://app.gitbook.com/account/developer
# Set the redirect URI to: {NEXTAUTH_URL}/api/connectors/gitbook/callback
GITBOOK_CLIENT_ID=
GITBOOK_CLIENT_SECRET=

# [OPTIONAL] Bearer token for the GitBook connector microservice
# Generate with: openssl rand -hex 32
GITBOOK_CONNECTOR_BEARER_TOKEN=

# [OPTIONAL] Base URL of the GitBook connector microservice.
# Default: http://gitbook-connector:8094
GITBOOK_CONNECTOR_URL=http://gitbook-connector:8094

# ============================================================================
# Powers the browser_task_start / browser_task_continue tools. The worker is
# internal-only: the app reaches it via BROWSER_WORKER_URL and both sides
# authenticate with a shared bearer secret. The feature stays OFF until an
# admin enables the two tools in the Tools UI and sets their domain allowlist.

# [REQUIRED to use browser automation] Shared secret (>= 16 chars), same value
# for app and worker. Generate with: openssl rand -hex 32
BROWSER_WORKER_SHARED_SECRET=

# [OPTIONAL] Worker fallback domain allowlist (comma-separated). The PRIMARY
# allowlist is set per-tool in the admin Tools UI. Supports exact hosts and
# *.example.com wildcards. An empty allowlist means deny all.
BROWSER_ALLOWLIST=

# [OPTIONAL - non-Docker dev only] docker-compose.yml already hardcodes
# http://browser-worker:8780. For `npm run dev` against the local worker set:
#BROWSER_WORKER_URL=http://localhost:8780

# [HAS DEFAULT] Worker session idle TTL (ms) and screenshot cadence (ms)
#BROWSER_SESSION_TTL_MS=900000
#BROWSER_SCREENSHOT_INTERVAL_MS=1000