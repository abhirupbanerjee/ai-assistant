{
  "$description": "Nonprofit theme — NGO, charity, foundation sites. Light mode.",
  "color": {
    "$type": "color",
    "primary": { "$value": "{color.green.green-700}", "$description": "Primary brand color — green for mission-driven impact" },
    "primary-hover": { "$value": "{color.green.green-600}", "$description": "Hover state of primary" },
    "secondary": { "$value": "{color.blue.blue-600}", "$description": "Secondary accent — blue for trust" },
    "background": { "$value": "{color.neutral.white}", "$description": "Page background" },
    "surface": { "$value": "{color.green.green-50}", "$description": "Card / surface background — warm tint" },
    "text": { "$value": "{color.neutral.gray-800}", "$description": "Body text" },
    "text-muted": { "$value": "{color.neutral.gray-500}", "$description": "Secondary / muted text" },
    "border": { "$value": "{color.neutral.gray-200}", "$description": "Border / divider color" },
    "success": { "$value": "{color.green.green-600}", "$description": "Success — donation confirmed" },
    "warning": { "$value": "{color.amber.amber-600}", "$description": "Warning state color" },
    "error": { "$value": "{color.red.red-600}", "$description": "Error state color" }
  },
  "font": {
    "heading": { "$value": "Merriweather, serif", "$type": "fontFamily", "$description": "Warm, trustworthy serif for headings" },
    "body": { "$value": "Inter, sans-serif", "$type": "fontFamily", "$description": "Body font stack" },
    "mono": { "$value": "JetBrains Mono, monospace", "$type": "fontFamily", "$description": "Monospace font stack" }
  },
  "shadow": {
    "shadow-sm": { "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "$type": "shadow" },
    "shadow-md": { "$value": "0 4px 12px rgba(0, 0, 0, 0.08)", "$type": "shadow" },
    "shadow-lg": { "$value": "0 8px 24px rgba(0, 0, 0, 0.1)", "$type": "shadow" }
  },
  "letterSpacing": {
    "letter-spacing": { "$value": "normal", "$type": "dimension" }
  }
}
