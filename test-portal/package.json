{
  "name": "test-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/**/*.test.ts",
    "test:contract": "node --import tsx --test tests/contract/**/*.test.ts",
    "test:isolation": "node --import tsx --test tests/isolation/**/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/**/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run type-check && npm test"
  },
  "dependencies": {
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
